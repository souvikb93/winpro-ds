{
  "name": "@euvino/ds",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EuvinoPRO design system: React components and tokens generated from the Figma library.",
  "exports": {
    ".": "./src/ds/index.ts",
    "./tokens.css": "./src/styles/tokens.css"
  },
  "scripts": {
    "tokens:build": "node scripts/build-tokens.mjs",
    "catalog": "node scripts/build-catalog.mjs",
    "llms": "node scripts/build-llms.mjs",
    "ds": "node scripts/ds-cli.mjs",
    "ds:mcp": "node scripts/ds-mcp.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run -s tokens:build -- --check && npm run -s typecheck && npm run -s test && node scripts/build-llms.mjs --check",
    "storybook": "storybook dev -p 6008",
    "build-storybook": "storybook build -o dist-storybook",
    "stories": "node scripts/build-stories.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.1.0",
    "@fontsource/roboto-condensed": "^5.1.0",
    "iconoir-react": "^7.10.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-mcp": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-docgen-typescript": "^2.4.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.6.6",
    "typescript": "^5.7.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.8",
    "zod": "^4.6.7"
  }
}
